# Get a free key: https://tavily.com
TAVILY_API_KEY=tvly-mock-key

# Get a free project: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://mock.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key

# Inside Antigravity, Gemini works without a key, but locally you might need one.
# If missing, the app gracefully falls back to mock responses.
GEMINI_API_KEY=mock-gemini-key
